# Copy to .env. Every value is optional: without keys Quorum runs in a clearly
# labelled simulation mode (simulated PayPal, rule-based agents, no market data).

# --- PayPal (sandbox) --------------------------------------------------------
# developer.paypal.com → Apps & Credentials → Sandbox → Create App (type: Merchant)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created by `npm run paypal:webhook -- https://your-app.example` after deploying
PAYPAL_WEBHOOK_ID=
# sandbox (default when credentials are set) | live | mock
# PAYPAL_MODE=sandbox
# The merchant agent reads PayPal through PayPal's remote MCP server. "off" uses REST.
# PAYPAL_MCP=on
# Name each merchant's own PayPal account as the payee of its orders.
# Verify on your sandbox first: capturing for another account needs its permission.
# PAYPAL_PAYEE_ROUTING=false
# CURRENCY=USD

# --- AI ----------------------------------------------------------------------
# console.anthropic.com → API keys. Without it, agents are rule-based.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Optional: OpenAI embeddings instead of the local multilingual embedding
# OPENAI_API_KEY=

# --- Market data ---------------------------------------------------------------
# trychannel3.com (hackathon promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# --- Email (optional) ----------------------------------------------------------
# Buyer notifications are always recorded in the outbox. With a Resend key they are emailed too.
# RESEND_API_KEY=
# NOTIFY_FROM=Quorum <onboarding@resend.dev>

# --- App -----------------------------------------------------------------------
# Public URL of this deployment (used in invite links and PayPal return URLs)
# BASE_URL=http://localhost:3000
# PORT=3000
# Shows "Add simulated buyer" and "Close group now" on group pages, for demos
DEMO_ADMIN=true
# Hosted demo: seed an empty database at start and reset the demo when it is used up and idle
# DEMO_AUTO_RESET=false
# Require a token on the merchant console API
# MERCHANT_TOKEN=
# Protects POST /api/cron/settle
# CRON_SECRET=
# How long a new group stays open (PayPal guarantees authorized funds for 72 hours)
# QUORUM_HOURS=72
# After closing, late buyers can join at the final price for this many hours (0 disables)
# LATE_JOIN_HOURS=24
# Reward per invited member who ends up paying, sent with the Payouts API (0 disables)
# REFERRAL_REWARD=0
